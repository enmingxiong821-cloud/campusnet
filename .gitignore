# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# 测试覆盖率产物
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest-workspace/

# 数据库运行时文件与本地备份（schema.sql 需要入库）
# 规则要覆盖全仓，不能只限 database/ 下——临时目录里也跑得出 .db
*.db
*.db-shm
*.db-wal
# 只忽略运行时的服务实例锁。不要写成 *.lock：那会连带忽略
# uv.lock / poetry.lock / Pipfile.lock 这类必须入库的依赖锁文件。
database/*.lock
database/backup/

# 密码混淆密钥，绝不能入库
*.key
.campusnet_obf.key
*.api-token

# 本地工具配置与日志（MCP 配置、临时输出）
# 锚定到仓库根：无锚定的 config.json 会连带忽略任意子目录下的同名文件，
# 将来前端或子包要提交自己的配置就会被静默吞掉。
/config.json
*.log
nul

# 本机敏感标识清单（真实校园内网地址、学校 SSID 等）。
# 仓库里只放 utils/local_sensitive.example.txt，真实清单保持本地。
/utils/local_sensitive.txt

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时目录
tmp/
*.tmp

# 打包产物（PyInstaller）
build/
dist/

# Flutter 移动端（project/mobile）。flutter create 在工程内生成的那两份
# .gitignore 已经管住了它自己的 build/ 与 android/ 下的签名材料，这里补的
# 是它们够不着的：被拷到仓库别处（比如桌面根目录）的 APK 与密钥库。
# 注意：下面都故意不带斜杠——带斜杠会锚定到仓库根，而根下并没有 android/
# 目录，「android/key.properties」这种写法会变成永远匹配不上的死规则。
.dart_tool/
.flutter-plugins
*.iml
*.apk
*.aab
# key.properties 是密钥库口令，.jks/.keystore 是密钥库本身。落点不一定在
# android/ 下，所以不按目录锚定。泄了等于别人能签发冒充你的更新包。
*.jks
*.keystore

# 抓包/验证工作区。`tmp/` 管不到它——目录名差一个下划线。
# 这里曾躺着明文真实学号与口令，以及从门户抓下来的第三方厂商 JS。
_tmp/
*_tmp/

# 交付资料：含本机绝对路径与内部信息，按要求只留本地不入库。
# 不删除，只是不让 git 看见——否则一次 git add -A 就全送出去了。
交付文件/

# 开发接续用的协作记忆快照（工作区外的一份副本）。
# 里面是每轮审查「刻意不改」的判断链、协作偏好与本机坑，同属内部信息，
# 一样只留本地。上游是工作区外的 memory 目录，这里放的是一份副本。
协作记忆/
